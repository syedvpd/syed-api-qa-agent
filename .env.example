# ==============================================================================
# SYED API QA AGENT — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure before starting in production or development.
# ==============================================================================

# ==============================================================================
# REQUIRED PRODUCTION VARIABLES (CRITICAL)
# These MUST be explicitly defined in production. Do not use development defaults.
# ==============================================================================

# 1. Database Connection URL
# Production PostgreSQL database JDBC URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/syed_apiqa

# 2. Database Username
SPRING_DATASOURCE_USERNAME=apiqa_user

# 3. Database Password
SPRING_DATASOURCE_PASSWORD=apiqa_password

# 4. JWT / Bearer Token HMAC-SHA256 Signing Secret
# MUST be set to a cryptographically secure, high-entropy 256-bit (32+ bytes) random string.
# Example generation: openssl rand -base64 32
SYED_AUTH_SECRET=generate-secure-random-256bit-secret-for-production

# 5. Database Column Encryption Key (AES-256-GCM)
# Used by EncryptedStringConverter for transparent encryption-at-rest of sensitive tokens.
# MUST be set to a high-entropy 256-bit (32+ bytes) secret in production.
# Example generation: openssl rand -base64 32
SYED_ENCRYPTION_KEY=generate-secure-random-256bit-key-for-production

# 6. Frontend Backend API Base URL
# The public or domain-routed URL where the Next.js client reaches the Spring Boot backend.
# In production, set to your publicly accessible domain or reverse proxy (e.g. https://api.qa.yourdomain.com).
NEXT_PUBLIC_API_URL=http://localhost:8080

# ==============================================================================
# DOCKER-COMPOSE LOCAL DATABASE DEFAULTS
# Used only when launching Postgres via `docker-compose up postgres`
# ==============================================================================
POSTGRES_DB=syed_apiqa
POSTGRES_USER=apiqa_user
POSTGRES_PASSWORD=apiqa_password

# ==============================================================================
# SERVICE PORTS
# ==============================================================================
SERVER_PORT=8080
FRONTEND_PORT=3000

# ==============================================================================
# SECURITY & SAFETY CONTROLS
# ==============================================================================
# Enforce cryptographic Bearer token authentication (always 'true' in production)
SYED_SECURITY_AUTH_ENABLED=true

# SSRF Anti-DNS Rebinding and Private IP Guard (always 'true' in production)
SYED_SAFETY_SSRF_PROTECTION_ENABLED=true

# Destructive DELETE suppression in production (always 'false' in production)
SYED_SAFETY_PRODUCTION_DELETE_ENABLED=false

# Fair concurrency semaphore capacity (default: 5 concurrent runs)
SYED_SAFETY_MAX_CONCURRENCY=5

# Outbound HTTP timeout limit in seconds
SYED_SAFETY_DEFAULT_TIMEOUT_SECONDS=15

# Response payload memory bound in bytes (default: 2MB = 2097152 bytes)
SYED_SAFETY_MAX_RESPONSE_SIZE_BYTES=2097152
